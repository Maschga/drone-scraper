[Unit]
Description=drone-scraper FPV Price Tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Documents/drone-scraper
ExecStart=/home/pi/.local/bin/uv run python main.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
